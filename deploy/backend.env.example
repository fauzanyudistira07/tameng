APP_NAME=SecSys
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=secsys-mysql
DB_PORT=3306
DB_DATABASE=secsys
DB_USERNAME=secsys
DB_PASSWORD=secsys_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database
REDIS_CLIENT=phpredis
REDIS_HOST=secsys-redis
REDIS_PORT=6379

FILESYSTEM_DISK=local

SECSYS_ENABLE_REAL_ENGINES=false
SECSYS_ENGINE_RUNTIME=docker
SECSYS_ENGINE_TIMEOUT_SECONDS=120
SECSYS_GITLEAKS_IMAGE=zricethezav/gitleaks:v8.28.0
SECSYS_REPOSITORY_WORKSPACE_ROOT=/data/repository-workspaces
SECSYS_DOCKER_HOST_WORKSPACE_ROOT=/data/repository-workspaces
SECSYS_CONTAINER_WORKSPACE_PATH=/repo
SECSYS_RUN_MIGRATIONS=false
SECSYS_RUN_SEEDERS=false
SECSYS_CACHE_BOOTSTRAP=true
